[Unit]
Description=nobelog blog (local, dynamic mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/博客/nobelog
ExecStart=/root/博客/nobelog/rust/target/release/nobelog serve --host 0.0.0.0 --port 10086 --root /root/博客/nobelog --dynamic
Restart=always
RestartSec=2
# 防止它自己成为内存大户：89 MB 用量，给足余量即可
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadOnlyPaths=/root/博客/nobelog

[Install]
WantedBy=multi-user.target
